# Esse arquivo normalmente é criado sozinho pelo instalar.bat / instalar.command.
# Só edite manualmente se precisar corrigir algum dado depois.
# Depois de editar, salve como ".env" (sem ".example") na mesma pasta.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_frete
DB_USER=postgres
DB_PASSWORD=coloque_aqui_a_senha_do_postgres

# Porta em que o sistema vai rodar (não precisa mexer)
PORT=3333
