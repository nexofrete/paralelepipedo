<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- Compilado para .NET 4.0; roda tambem com 4.5/4.6/4.7/4.8 instalado (necessario para TLS 1.2 da SEFAZ) -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>

  <connectionStrings>
    <add name="Postgres"
         connectionString="Server=localhost;Port=5432;Database=transportadora;User Id=postgres;Password=postgres;Timeout=15;CommandTimeout=60;" />
  </connectionStrings>

  <appSettings>
    <!-- URL base do QR Code do DACTE (SVRS). -->
    <add key="CTe.QrCode" value="https://dfe-portal.svrs.rs.gov.br/cte/qrCode" />

    <!--
      Webservices: por padrao o sistema usa a SVRS, que autoriza o CT-e do RJ e da maioria das UFs.
      Para empresas de MG, MS, MT, PR ou SP, descomente e informe as URLs da sua SEFAZ.
      Formato da chave: CTe.{Servico}.{Ambiente}   (Ambiente 1 = producao, 2 = homologacao)
      Servicos: RecepcaoSinc, StatusServico, Consulta, RecepcaoEvento
    -->
    <!--
    <add key="CTe.RecepcaoSinc.2"   value="https://cte-homologacao.svrs.rs.gov.br/ws/CTeRecepcaoSincV4/CTeRecepcaoSincV4.asmx" />
    <add key="CTe.StatusServico.2"  value="https://cte-homologacao.svrs.rs.gov.br/ws/CTeStatusServicoV4/CTeStatusServicoV4.asmx" />
    <add key="CTe.Consulta.2"       value="https://cte-homologacao.svrs.rs.gov.br/ws/CTeConsultaV4/CTeConsultaV4.asmx" />
    <add key="CTe.RecepcaoEvento.2" value="https://cte-homologacao.svrs.rs.gov.br/ws/CTeRecepcaoEventoV4/CTeRecepcaoEventoV4.asmx" />
    -->

    <!--
      Consulta de CNPJ (preenche o cadastro automaticamente). {0} = CNPJ so com numeros.
      CNPJa traz tambem a inscricao estadual; BrasilAPI e usada se a primeira falhar.
    -->
    <add key="Cnpj.UrlCnpja" value="https://open.cnpja.com/office/{0}" />
    <add key="Cnpj.UrlBrasilApi" value="https://brasilapi.com.br/api/cnpj/v1/{0}" />

    <!-- Somente para testes se a cadeia de certificados ICP-Brasil nao estiver instalada no Windows. -->
    <add key="CTe.IgnorarErroCertificadoServidor" value="false" />
  </appSettings>
</configuration>
